# Runtime for both the replica portal and the OCI proxy; no scanner/validator tools.
FROM --platform=$BUILDPLATFORM node:24.19.0-alpine AS frontend
WORKDIR /build/frontend
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN npm install --global pnpm@11.19.0 && pnpm install --frozen-lockfile
COPY frontend/ ./
RUN pnpm build

FROM python:3.12-slim
# The same checksum-pinned verifier as full CATS; signatures are checked offline.
ARG COSIGN_VERSION=2.6.1
ARG TARGETARCH
ARG COSIGN_SHA256_AMD64=064954c5d8c7e3b28188eee5b1727b31c411550bc5fefd41aa672d3c761d103a
ARG COSIGN_SHA256_ARM64=56a16480bdd56ec789abaa65924402f6b92c0041f06885995853c05567b76f34
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && case "${TARGETARCH}" in \
         amd64) COSIGN_SHA256="${COSIGN_SHA256_AMD64}" ;; \
         arm64) COSIGN_SHA256="${COSIGN_SHA256_ARM64}" ;; \
         *) echo "Unsupported replica architecture: ${TARGETARCH}" >&2; exit 1 ;; \
       esac \
    && curl --fail --location --retry 3 "https://github.com/sigstore/cosign/releases/download/v${COSIGN_VERSION}/cosign-linux-${TARGETARCH}" -o /tmp/cosign \
    && echo "${COSIGN_SHA256}  /tmp/cosign" | sha256sum -c - \
    && install -m 0755 /tmp/cosign /usr/local/bin/cosign \
    && rm /tmp/cosign && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV CATS_MODE=replica PYTHONDONTWRITEBYTECODE=1
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app ./app
COPY LICENSE /app/LICENSE
COPY --from=frontend /build/app/static/frontend ./app/static/frontend
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
