POSTGRES_DB=cats
POSTGRES_USER=cats
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
CATS_IMAGE=cats:1.3
# The canonical stack always includes a local Keycloak instance on port 8081.
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.3
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-keycloak-password
CATS_BOOTSTRAP_USERNAME=admin
CATS_BOOTSTRAP_PASSWORD=replace-with-a-long-random-bootstrap-password
CATS_ENV=development
# Local testing only; leave false in shared/production environments.
CATS_DEV_AUTH_BYPASS=true
# Local testing only: allow an HTTP Keycloak issuer on a LAN address.
# Leave false/unset when CATS is not an isolated development environment.
CATS_OIDC_ALLOW_INSECURE_HTTP=true
CATS_DEV_USER=admin
PIPELINE_API_TOKEN=replace-with-a-long-random-pipeline-token
CATS_PATCH_WORKER_TOKEN=replace-with-a-long-random-worker-token
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this stable; changing it makes previously stored OIDC/registry secrets unreadable.
CATS_CONFIG_ENCRYPTION_KEY=replace-with-a-fernet-key
ALLOW_SERVICE_DELETE=false
CATS_REMEDIATION_WORKERS=2
CATS_REMEDIATION_SOURCE_MAX_BYTES=10485760
# Optional isolated cluster used only for Level 2 candidate validation.
CATS_REMEDIATION_KUBECONFIG=
# Deployment Validation is independent of the authoritative static scan. Run
# it only on a dedicated Docker host/VM: kind requires Docker-socket-equivalent
# privileges even though submitted workloads are restricted before install.
CATS_DEPLOYMENT_VALIDATION_ENABLED=false
CATS_PIPELINE_MAX_REQUEST_BYTES=16777216
CATS_DEPLOYMENT_VALIDATION_WORKERS=1
CATS_DEPLOYMENT_CLUSTER_PREFIX=cats-validation
CATS_DEPLOYMENT_NAMESPACE_PREFIX=cats-validation
CATS_DEPLOYMENT_KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
# Optional path inside the portal container to a preloaded docker-save archive.
CATS_DEPLOYMENT_KIND_NODE_ARCHIVE=
CATS_DEPLOYMENT_API_HOST=host.docker.internal
CATS_DEPLOYMENT_API_ADDRESS=127.0.0.1
CATS_DEPLOYMENT_REQUIRE_LOCAL_IMAGES=true
CATS_DEPLOYMENT_CREATE_TIMEOUT=180
CATS_DEPLOYMENT_INSTALL_TIMEOUT=180
CATS_DEPLOYMENT_READINESS_TIMEOUT=600
CATS_DEPLOYMENT_COLLECTION_TIMEOUT=60
CATS_DEPLOYMENT_CLEANUP_TIMEOUT=60
CATS_DEPLOYMENT_TOTAL_TIMEOUT=600
CATS_INGEST_MAX_SOURCE_FILES=5000
CATS_INGEST_MAX_SOURCE_BYTES=104857600
CATS_DEPLOYMENT_MAX_PODS=50
CATS_DEPLOYMENT_MAX_OBJECTS=500
CATS_DEPLOYMENT_MAX_SOURCE_BYTES=104857600
CATS_DEPLOYMENT_MAX_RENDER_BYTES=20971520
CATS_DEPLOYMENT_MAX_COMMAND_OUTPUT_BYTES=25165824
CATS_DEPLOYMENT_MAX_CPU=8
CATS_DEPLOYMENT_MAX_MEMORY=16Gi
CATS_DEPLOYMENT_MAX_STORAGE=20Gi
CATS_DEPLOYMENT_NODE_CPUS=4
CATS_DEPLOYMENT_NODE_MEMORY=8g
CATS_DEPLOYMENT_NODE_PIDS=2048
CATS_DEPLOYMENT_ALLOW_NETWORK_EGRESS=false
# Built-in offline MetalLB is automatic when a generic LoadBalancer is required.
CATS_DEPLOYMENT_LOAD_BALANCER_PROVIDER_ENABLED=true
CATS_DEPLOYMENT_LOAD_BALANCER_BUNDLE_DIR=/opt/cats/validation/loadbalancer
CATS_DEPLOYMENT_INGRESS_CONTROLLER_ENABLED=true
CATS_DEPLOYMENT_INGRESS_BUNDLE_DIR=/opt/cats/validation/ingress
CATS_DEPLOYMENT_INGRESS_TIMEOUT=90
CATS_DEPLOYMENT_LOAD_BALANCER_TIMEOUT=90
# Portal image signing keys are uploaded under Administration → Configuration.
# Keep false while using HTTP. Change to true only after the portal is served through HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_HOURS=8
CATS_IDENTITY_MODE=local
# After creating the cats realm/client locally, use these values with identity mode "both" or "oidc".
CATS_OIDC_ISSUER_URL=http://keycloak:8080/realms/cats
# Optional browser-facing issuer when the value above is reachable only inside Docker.
# Local compose example: http://localhost:8081/realms/cats
CATS_OIDC_BROWSER_ISSUER_URL=http://localhost:8081/realms/cats
CATS_OIDC_CLIENT_ID=cats-portal
CATS_OIDC_CLIENT_SECRET=replace-with-keycloak-client-secret
CATS_OIDC_REDIRECT_URI=http://localhost:8080/auth/oidc/callback
CATS_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:8080/login
CATS_OIDC_SCOPES=openid profile email groups
CATS_OIDC_GROUPS_CLAIM=groups
CATS_OIDC_ROLES_CLAIM=realm_access.roles
CATS_OIDC_ROLE_MAP={"cybersecurity":"Cybersecurity","assessor":"Assessor","service-manager":"Service Manager","administrator":"Administrator"}
CATS_OIDC_GROUP_ROLE_MAP={}
CATS_OIDC_DEFAULT_ROLE=
CATS_OIDC_GROUP_DEFAULT_ROLE=Service Manager
CATS_OIDC_AUTO_PROVISION=true
CATS_OIDC_AUTO_PROVISION_GROUPS=false
