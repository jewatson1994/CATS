# Repository-root Compose settings. Copy to .env; replace all secret/path placeholders.
# Choose the same CATS_IMAGE tag used by your build. Do not overwrite an existing .env.

POSTGRES_DB=cats
POSTGRES_USER=cats
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
# Separate intelligence instance; unset password inherits POSTGRES_PASSWORD.
INTELLIGENCE_POSTGRES_DB=cats_intelligence
INTELLIGENCE_POSTGRES_USER=cats_intelligence
# INTELLIGENCE_POSTGRES_PASSWORD=replace-with-a-separate-random-password
CATS_INTELLIGENCE_IMPORT_CPUS=1.0
CATS_INTELLIGENCE_IMPORT_MEMORY=2g
# Daily portal backup and isolated restore verification (UTC).
BACKUP_UTC_TIME=03:00
BACKUP_RETENTION_COUNT=7
CATS_DB_BACKUP_DIR=./backups/postgres
CATS_IMAGE=cats:local
CATS_PORT=8080
# Optional legacy prepared release. Leave empty for automatic on-demand provisioning.
CATS_MANAGED_VALIDATOR_RELEASE_SOURCE=
CATS_BOOTSTRAP_USERNAME=admin
CATS_BOOTSTRAP_PASSWORD=replace-with-a-long-random-bootstrap-password
CATS_ENV=production
# Local testing only; leave false in shared/production environments.
CATS_DEV_AUTH_BYPASS=false
# Local testing only: allow an HTTP external OIDC issuer.
# Leave false/unset when CATS is not an isolated development environment.
CATS_OIDC_ALLOW_INSECURE_HTTP=false
CATS_DEV_USER=admin
PIPELINE_API_TOKEN=replace-with-a-long-random-pipeline-token
CATS_PATCH_WORKER_TOKEN=replace-with-a-long-random-worker-token
# Dedicated scan worker: use a distinct random token shared with the Portal.
CATS_SCAN_WORKER_TOKEN=replace-with-a-long-random-scan-worker-token
CATS_SCAN_WORKER_ID=scan-worker
# Optional control-service-only JSON: {"scan-worker":{"current":"32+ character token","previous":"prior token"}}
CATS_SCAN_WORKER_CREDENTIALS=
CATS_SCAN_PORTAL_URL=http://portal-control:8001
CATS_SCAN_JOB_ROOT=/var/lib/cats-scan
CATS_SCAN_CONCURRENCY=2
CATS_SCAN_LEASE_SECONDS=90
CATS_SCAN_JOB_TIMEOUT=3600
CATS_SCAN_QUEUE_CAPACITY=100
CATS_SCAN_MAX_ATTEMPTS=3
# Application workspace budget; configure a host volume quota for a hard disk limit.
CATS_SCAN_DISK_BYTES=21474836480
CATS_SCAN_CPUS=2
CATS_SCAN_MEMORY=4g
CATS_SCAN_PIDS=256
# /tmp is for incidental tools; large artifact temp files use the disk workspace.
CATS_SCAN_TMP_BYTES=536870912
CATS_SCAN_SCANNER_UID=10002
CATS_SCAN_SCANNER_GID=10002
# Create this directory before Compose starts; optionally supply registry config.json.
CATS_SCAN_REGISTRY_AUTH_SOURCE=./scan-registry-auth
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this stable; changing it makes previously stored OIDC/registry secrets unreadable.
CATS_CONFIG_ENCRYPTION_KEY=replace-with-a-fernet-key
ALLOW_SERVICE_DELETE=false
CATS_REMEDIATION_WORKERS=2
# Require bound candidate validation before OCI or deployable bundle delivery.
CATS_REMEDIATION_REQUIRE_VALIDATION=true
CATS_REMEDIATION_SOURCE_MAX_BYTES=10485760
# Export All documentation size limit (256 MiB); OCI adds 2 MiB for release metadata.
CATS_RELEASE_DOC_MAX_BYTES=268435456
# Default Cyber approval lifetime (1..3650 days); saved Settings > Image signing value takes precedence. New approvals only.
CATS_CYBER_APPROVAL_VALIDITY_DAYS=90
# Comma-separated HTTPS origins allowed to receive destination credentials for OCI tokens.
# Empty permits only the registry's own origin. Example: https://auth.registry.example
CATS_OCI_TOKEN_REALMS=
# Optional isolated cluster used only for Level 2 candidate validation.
CATS_REMEDIATION_KUBECONFIG=
# Deployment Validation is independent of the authoritative static scan. Run
# it only on a dedicated Docker host/VM: kind requires Docker-socket-equivalent
# privileges even though submitted workloads are restricted before install.
CATS_DEPLOYMENT_VALIDATION_ENABLED=false
CATS_PIPELINE_MAX_REQUEST_BYTES=16777216
CATS_DEPLOYMENT_VALIDATION_WORKERS=1
CATS_DEPLOYMENT_CLUSTER_PREFIX=cats-validation
CATS_DEPLOYMENT_NAMESPACE_PREFIX=cats-validation
# Expected Kind node base image/version and immutable digest for HQ provisioning.
# Override with your Harbor image:tag@sha256:digest; leaving unset keeps the shipped default.
# See docs/durable-workers.md for mirror matching, compatibility and recreation steps.
CATS_DEPLOYMENT_KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
# Optional path inside the portal container to a preloaded docker-save archive.
CATS_DEPLOYMENT_KIND_NODE_ARCHIVE=
CATS_DEPLOYMENT_API_HOST=host.docker.internal
CATS_DEPLOYMENT_API_ADDRESS=127.0.0.1
CATS_DEPLOYMENT_REQUIRE_LOCAL_IMAGES=true
CATS_DEPLOYMENT_CREATE_TIMEOUT=180
CATS_DEPLOYMENT_INSTALL_TIMEOUT=180
CATS_DEPLOYMENT_READINESS_TIMEOUT=600
CATS_DEPLOYMENT_COLLECTION_TIMEOUT=60
CATS_DEPLOYMENT_CLEANUP_TIMEOUT=60
CATS_DEPLOYMENT_TOTAL_TIMEOUT=600
CATS_INGEST_MAX_SOURCE_FILES=5000
CATS_INGEST_MAX_SOURCE_BYTES=104857600
CATS_DEPLOYMENT_MAX_PODS=50
CATS_DEPLOYMENT_MAX_OBJECTS=500
CATS_DEPLOYMENT_MAX_SOURCE_BYTES=104857600
CATS_DEPLOYMENT_MAX_RENDER_BYTES=20971520
CATS_DEPLOYMENT_MAX_COMMAND_OUTPUT_BYTES=25165824
CATS_DEPLOYMENT_MAX_CPU=8
CATS_DEPLOYMENT_MAX_MEMORY=16Gi
CATS_DEPLOYMENT_MAX_STORAGE=20Gi
CATS_DEPLOYMENT_NODE_CPUS=4
CATS_DEPLOYMENT_NODE_MEMORY=8g
CATS_DEPLOYMENT_NODE_PIDS=2048
CATS_DEPLOYMENT_ALLOW_NETWORK_EGRESS=false
# Built-in offline MetalLB is automatic when a generic LoadBalancer is required.
CATS_DEPLOYMENT_LOAD_BALANCER_PROVIDER_ENABLED=true
CATS_DEPLOYMENT_LOAD_BALANCER_BUNDLE_DIR=/opt/cats/validation/loadbalancer
CATS_DEPLOYMENT_INGRESS_CONTROLLER_ENABLED=true
CATS_DEPLOYMENT_INGRESS_BUNDLE_DIR=/opt/cats/validation/ingress
CATS_DEPLOYMENT_INGRESS_TIMEOUT=90
CATS_DEPLOYMENT_LOAD_BALANCER_TIMEOUT=90
# Portal image signing keys are uploaded under Administration → Configuration.
# Keep false while using HTTP. Change to true only after the portal is served through HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_HOURS=8
CATS_IDENTITY_MODE=local

# Optional external OIDC. Keep blank for local accounts; configure both/oidc mode when ready.
CATS_OIDC_ISSUER_URL=
# Optional browser-facing issuer when the internal issuer is not browser-accessible.
CATS_OIDC_BROWSER_ISSUER_URL=
# OIDC token clock-skew tolerance: integer seconds, 0 through 300; default 60.
# Environment-only setting (no Administration field). Do not leave blank.
# After changing, recreate portal and portal-control in Compose, or restart a direct portal process.
# No image rebuild is needed; keep the host clock synchronized.
OIDC_CLOCK_SKEW_SECONDS=60
CATS_OIDC_CLIENT_ID=
CATS_OIDC_CLIENT_SECRET=
CATS_OIDC_REDIRECT_URI=
CATS_OIDC_POST_LOGOUT_REDIRECT_URI=
CATS_OIDC_SCOPES=openid profile email groups
CATS_OIDC_GROUPS_CLAIM=groups
CATS_OIDC_ROLES_CLAIM=realm_access.roles
CATS_OIDC_ROLE_MAP={"cybersecurity":"Cybersecurity","assessor":"Assessor","service-manager":"Service Manager","administrator":"Administrator"}
CATS_OIDC_GROUP_ROLE_MAP={}
CATS_OIDC_DEFAULT_ROLE=
CATS_OIDC_GROUP_DEFAULT_ROLE=Service Manager
CATS_OIDC_AUTO_PROVISION=true
CATS_OIDC_AUTO_PROVISION_GROUPS=false

# Helm archive staging (separate from retained text and deployment limits).
CATS_PUBLIC_MAX_CHART_BYTES=536870912
CATS_UPLOAD_REQUEST_MAX_BYTES=1073741824
CATS_PUBLIC_MAX_CHART_EXPANDED_BYTES=1073741824
CATS_PUBLIC_MAX_CHART_MEMBERS=10000
CATS_PUBLIC_HELM_PULL_TIMEOUT=180
CATS_PUBLIC_HELM_TEMP_RESERVE_BYTES=0
CATS_ARTIFACT_SOURCE_MAX_BYTES=104857600
HELM_DISCOVERY_MAX_ARCHIVE_BYTES=536870912
HELM_DISCOVERY_MAX_ARCHIVE_EXPANDED_BYTES=1073741824
HELM_DISCOVERY_MAX_ARCHIVE_MEMBERS=10000

# Offline exchange bounds and expired-preview maintenance.
CATS_SERVICE_DEFINITION_MAX_BYTES=10485760
CATS_SERVICE_DEFINITION_MAX_NODES=200000
CATS_SERVICE_DEFINITION_MAX_DEPTH=64
CATS_SERVICE_DEFINITION_MAX_STRING_BYTES=1048576
CATS_SERVICE_DEFINITION_MAX_COMPONENTS=1000
CATS_WORKBOOK_MAX_BYTES=20971520
CATS_BUNDLE_MAX_BYTES=104857600
CATS_BUNDLE_MAX_RECORDS=100000
CATS_BUNDLE_MAX_JSON_NODES=2000000
CATS_PREVIEW_CLEANUP_INTERVAL_SECONDS=300
CATS_PREVIEW_CLEANUP_BATCH_SIZE=100

# Durable scan admission and evidence maintenance.
CATS_SCAN_ANONYMOUS_QUEUE_CAPACITY=10
CATS_SCAN_PREPARATION_TTL_SECONDS=900
CATS_SCAN_RETENTION_DAYS=30
CATS_SCAN_CLEANUP_BATCH_SIZE=20

# Durable HQ workers: one active operation per process.
CATS_JOB_QUEUE_CAPACITY=200
CATS_JOB_LEASE_SECONDS=120
CATS_REMEDIATION_CPUS=1.0
CATS_REMEDIATION_MEMORY=2g
CATS_EXPORT_CPUS=1.0
CATS_EXPORT_MEMORY=1g
CATS_EXPORT_MAX_BYTES=268435456
CATS_EXPORT_DISK_BYTES=4294967296
CATS_EXPORT_RETENTION_HOURS=24
CATS_PROVISIONING_CPUS=1.0
CATS_PROVISIONING_MEMORY=2g
# Defaults to the exact image ID of the running provisioning-worker container.
CATS_PROVISIONING_CATS_IMAGE=
# Optional acquisition from approved internal Harbor; immutable @sha256 references only.
CATS_PROVISIONING_INTERNAL_REGISTRIES=
CATS_PROVISIONING_CATS_SOURCE=
# Optional approved pull source; its digest MUST match CATS_DEPLOYMENT_KIND_NODE_IMAGE.
# Setting only this source does not override the expected Kind node pin.
CATS_PROVISIONING_NODE_SOURCE=
# Optional offline Docker .deb acquisition, keyed by OS-release-architecture.
CATS_PROVISIONING_INTERNAL_PACKAGE_HOSTS=
CATS_PROVISIONING_DOCKER_PACKAGES=

# Verified provisioning archives/packages: 32 GiB, evicted after seven days.
CATS_PROVISIONING_CACHE_MAX_BYTES=34359738368

# Discovery network retrieval (explicit approved sources, never inferred from uploads).
HELM_ALLOW_NETWORK=false
CATS_DISCOVERY_HELM_SOURCES=[]
CATS_DISCOVERY_HELM_ORIGINS=[]
CATS_DISCOVERY_HELM_TOKEN_ORIGINS=[]
CATS_DISCOVERY_MIRROR_DIR=./deploy/discovery-mirror
# Public GitLab example: python scripts/configure-discovery-gitlab.py

# Discovery has no application size or file-count budget by default (0 = unlimited).
# Positive values opt into operator-selected budgets; bytes are exact integers.
CATS_DISCOVERY_MAX_UPLOAD_BYTES=0
CATS_DISCOVERY_MAX_FILE_BYTES=0
CATS_DISCOVERY_MAX_EXTRACTED_BYTES=0
CATS_DISCOVERY_MAX_FILES=0
CATS_DISCOVERY_MAX_RENDERED_BYTES=0
