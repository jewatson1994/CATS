# Legacy root-stack override only; templates/compose.main.yaml includes Nginx.
# For the integrated template, use templates/main.env.example and no Nginx override.
# Add these to your EXISTING deployment .env; keep its credentials and keys.
# Replace the example hostnames below with your own distinct DNS names.
# Both DNS names must resolve to the VM address from every client.
CATS_PORTAL_HOSTNAME=portal.example.com
CATS_OCI_HOSTNAME=registry.example.com

# Absolute directories on the Docker host. Each contains tls.crt and tls.key.
CATS_PORTAL_CERT_DIR=/opt/cats/certs/portal
CATS_OCI_CERT_DIR=/opt/cats/certs/oci-proxy

# Persist the legacy overlay for normal `docker compose` and upgrade commands.
# Preserve other active overrides and keep compose.nginx.yml last.
# The current main Compose file already defines oci-proxy:
COMPOSE_FILE=compose.yaml:compose.nginx.yml
# For older deployments where oci-proxy is still a separate overlay:
# COMPOSE_FILE=compose.yaml:compose.oci-proxy.yml:compose.nginx.yml
