# Copy to a protected file such as /secure/replica.env for templates/compose.replica.yaml.
# Use a separate project/database from authoritative CATS. Never commit real secrets.
# Setup: templates/README.md (CATS replica) and docs/oci-replica-deployment-runbook.md.

# 1. Required image — select a built replica image tag or immutable digest.
# Load this image, postgres:16, and the pinned Nginx image before offline startup.
CATS_REPLICA_IMAGE=
# Optional override; the Compose default is this reviewed image digest.
# CATS_NGINX_IMAGE=nginx:stable-alpine@sha256:0e52bd054126cdc040b1276c0af347aeb02a41b9cfe305d6094767ac30e97949

# 2. Required secrets — replace both passwords and generate a Fernet key.
POSTGRES_PASSWORD=replace-with-a-unique-database-password
CATS_BOOTSTRAP_PASSWORD=replace-with-a-unique-administrator-password
# Generate with cryptography as described in the runbook; preserve across upgrades.
CATS_CONFIG_ENCRYPTION_KEY=

# 3. Local database and initial administrator — defaults usually need no changes.
POSTGRES_DB=cats
POSTGRES_USER=cats
CATS_BOOTSTRAP_USERNAME=admin
# Compose fixes replica mode; this value does not switch it to full CATS.
CATS_MODE=replica

# 4. HTTPS access — replace both DNS names and prepare their certificate files.
# Both names must resolve to this replica host and differ from one another.
# Nginx owns TCP 443 on all host addresses. Use a separate host or override ports.
CATS_PORTAL_HOSTNAME=
CATS_OCI_HOSTNAME=
# Each directory needs tls.crt (leaf + intermediates) and tls.key, readable by CATS.
# Certificates must cover their corresponding hostname; trust the CA on clients.
CATS_PORTAL_CERT_DIR=/opt/cats/certs
CATS_OCI_CERT_DIR=/opt/cats/oci-certs

# 5. Storage — preserve these volumes across upgrades.
# 10 GiB blob cache; provision database/evidence storage separately.
CATS_OCI_CACHE_MAX_BYTES=10737418240

# 6. Optional discovery limits.
# One discovery budget covers catalog pages and all release repositories per sync.
# Exceeding a limit fails synchronization; it never silently truncates results.
CATS_REPLICA_DISCOVERY_MAX_PAGES=100
CATS_REPLICA_DISCOVERY_MAX_ENTRIES=10000
CATS_REPLICA_DISCOVERY_MAX_RELEASES=10000

# 7. Optional single sign-on.
# Configure a reachable local OIDC/Keycloak realm for disconnected installations.
# Local authentication remains available when OIDC is disabled.
CATS_OIDC_ENABLED=false
CATS_OIDC_ISSUER_URL=
CATS_OIDC_CLIENT_ID=
CATS_OIDC_CLIENT_SECRET=
CATS_OIDC_REDIRECT_URI=
