# Dedicated Linux amd64 sandbox only. Keep the real file outside Git, mode 0600.
# Host networking uses these listen ports directly; there are no Docker port mappings.
CATS_VALIDATOR_IMAGE=cats-validator:local
CATS_VALIDATOR_TLS_DIR=/opt/cats-validator/tls
CATS_VALIDATOR_CA_BUNDLE=/opt/cats-validator/trust/ca-bundle.pem
CATS_VALIDATOR_ADMIN_USERNAME=admin
CATS_VALIDATOR_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_AT_LEAST_14_CHARACTERS
CATS_VALIDATOR_CLIENT_FINGERPRINTS=REPLACE_WITH_PRODUCTION_CLIENT_CERT_SHA256_64_HEX_CHARACTERS
CATS_VALIDATOR_DOCKER_SHA256=REPLACE_WITH_VERIFIED_DOCKER_27_5_1_AMD64_ARCHIVE_SHA256
CATS_DEPLOYMENT_KIND_NODE_IMAGE=REPLACE_WITH_APPROVED_KIND_IMAGE_AT_SHA256_DIGEST
CATS_VALIDATOR_EXECUTION_MODE=strict
CATS_VALIDATOR_LISTEN=0.0.0.0
CATS_VALIDATOR_PORT=8443
CATS_VALIDATOR_ADMIN_LISTEN=0.0.0.0
CATS_VALIDATOR_ADMIN_PORT=8444
