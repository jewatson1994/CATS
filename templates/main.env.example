# Copy to a protected file outside Git. Replace every REPLACE value.
CATS_IMAGE=REPLACE_WITH_YOUR_BUILT_CATS_IMAGE
CATS_PORT=8080
POSTGRES_DB=cats
POSTGRES_USER=cats
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_DATABASE_PASSWORD
CATS_BOOTSTRAP_USERNAME=admin
CATS_BOOTSTRAP_PASSWORD=REPLACE_WITH_UNIQUE_ADMIN_PASSWORD
CATS_ENV=production
CATS_IDENTITY_MODE=local
CATS_DEV_AUTH_BYPASS=false
CATS_CONFIG_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
PIPELINE_API_TOKEN=REPLACE_WITH_RANDOM_PIPELINE_TOKEN
CATS_PATCH_WORKER_TOKEN=REPLACE_WITH_RANDOM_WORKER_TOKEN
# Set true when serving the portal over HTTPS through your reverse proxy.
SESSION_COOKIE_SECURE=false
HELM_ALLOW_NETWORK=false
CATS_DEPLOYMENT_VALIDATION_ENABLED=false
