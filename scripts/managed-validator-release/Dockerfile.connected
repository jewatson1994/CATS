ARG UBUNTU_IMAGE
FROM ${UBUNTU_IMAGE}
ARG DOCKER_KEY_SHA256
ARG DOCKER_KEY_FINGERPRINT
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl gnupg python3 python3-pip python3-yaml gcc libc6-dev skopeo \
    && mkdir -p /etc/apt/keyrings \
    && curl --fail --location https://download.docker.com/linux/ubuntu/gpg -o /tmp/docker.asc \
    && printf '%s  /tmp/docker.asc\n' "$DOCKER_KEY_SHA256" | sha256sum --check - \
    && test "$(gpg --show-keys --with-colons /tmp/docker.asc | awk -F: '$1 == "fpr" { print $10; exit }')" = "$DOCKER_KEY_FINGERPRINT" \
    && gpg --dearmor --output /etc/apt/keyrings/docker.gpg /tmp/docker.asc \
    && echo 'deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu jammy stable' > /etc/apt/sources.list.d/docker.list \
    && rm /tmp/docker.asc
# Only build-time seal imports require portal dependencies in this connected harness.
COPY portal/requirements.txt /tmp/requirements.txt
RUN python3 -m pip install --no-cache-dir -r /tmp/requirements.txt
WORKDIR /src
